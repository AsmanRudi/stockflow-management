# PostgreSQL connection string from your cloud provider
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Used only by local Express dev server
PORT=4000
FRONTEND_URL="http://localhost:5173"
# Use a long random secret (at least 32 characters)
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
# Admin user created by npm run db:seed
ADMIN_NAME="StockFlow Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeThisPassword123!"
# In production set COOKIE_SECURE=true and FRONTEND_URL to your deployed web origin
COOKIE_SECURE="false"